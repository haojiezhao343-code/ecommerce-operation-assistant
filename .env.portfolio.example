# 作品集展示环境变量模板
# 用法：cp .env.portfolio.example .env 然后把 <> 占位符换成真实值
# 生成随机串：openssl rand -base64 36

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=<强随机密码>
MYSQL_DATABASE=ecommerce_operation

# ---------- 对外入口 ----------
# 容器对外端口，防火墙需同时放通该端口
WEB_PORT=80

# ---------- 应用 ----------
APP_ENV=production
# production 校验：至少 32 字符，且不能以 replace_with_ 开头
AUTH_SECRET_KEY=<至少32字符的随机串>
# 作品集不连接 PostgreSQL 检查点，但 production 校验要求该值至少 16 字符
AGENT_CHECKPOINT_PASSWORD=<至少16字符的随机串>

# ---------- 演示账号（首次启动后执行 bootstrap 使用）----------
BOOTSTRAP_EMAIL=demo@example.com
BOOTSTRAP_PASSWORD=<演示账号密码>
BOOTSTRAP_DISPLAY_NAME=演示账号
